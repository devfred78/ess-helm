{
    admin off
    auto_https off
}

:8080 {
    # Logging
    log {
        output stdout
        format console
        level INFO
    }

    # En-têtes CORS et de sécurité
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "X-Requested-With, Content-Type, Authorization, Date"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Matrix Well-Known Delegation
    # (fichier passé par envsubst dans l'entrypoint : utiliser ${VAR}, pas {$VAR})
    handle /.well-known/matrix/server {
        header Content-Type application/json
        respond `{"m.server": "${SERVER_NAME}:443"}` 200
    }

    handle /.well-known/matrix/client {
        header Content-Type application/json
        respond `{"m.homeserver": {"base_url": "${PUBLIC_BASEURL}"}, "org.matrix.msc2965.authentication": {"issuer": "${PUBLIC_BASEURL}/auth/", "account": "${PUBLIC_BASEURL}/auth/account"}}` 200
    }

    # Matrix Authentication Service (MAS), servi sous le préfixe /auth (cf. mas.yaml)
    handle /.well-known/openid-configuration {
        rewrite * /auth/.well-known/openid-configuration
        reverse_proxy 127.0.0.1:8081
    }

    handle /auth/* {
        reverse_proxy 127.0.0.1:8081
    }

    # Synapse Homeserver Matrix APIs
    handle /_matrix/* {
        # Endpoints de compatibilité (login/logout/refresh) pris en charge par MAS
        @mas_compat path_regexp ^/_matrix/client/(r0|v3)/(login|logout|refresh)(/.*)?$
        handle @mas_compat {
            rewrite * /auth{path}
            reverse_proxy 127.0.0.1:8081
        }

        handle {
            reverse_proxy 127.0.0.1:8008 {
                header_up X-Real-IP {remote_host}
            }
        }
    }

    handle /_synapse/* {
        reverse_proxy 127.0.0.1:8008 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Element Admin Console
    handle_path /admin* {
        root * /var/www/element-admin
        file_server
        try_files {path} /index.html
    }

    # Element Web Client
    handle {
        root * /var/www/element-web
        file_server
        try_files {path} /index.html
    }
}
